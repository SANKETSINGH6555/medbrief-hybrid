# MedBrief Hybrid - Environment Variables Template
# Copy this file to .env.local and populate with your credentials.
# NOTE: Never commit .env.local or secret keys to version control.

VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-app.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
VITE_FIREBASE_APP_ID="your-web-app-id"
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"
VITE_RECAPTCHA_SITE_KEY="your-recaptcha-enterprise-site-key"
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN="your-app-check-debug-token-uuid"
